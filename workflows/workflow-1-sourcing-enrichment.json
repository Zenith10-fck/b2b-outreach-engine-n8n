    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let link = item.json.link || \"\";\n  let rawTitle = item.json.title || \"\";\n  \n  let cleanName = \"\";\n  let domainName = \"techcrunch.com\";\n\n  // 1. Ekstraksi Domain dari URL\n  try {\n    let url = new URL(link);\n    domainName = url.hostname.replace('www.', '');\n    \n    // 2. Trik Cerdas: Jika ini halaman author, ambil nama dari URL Slug!\n    if (link.includes(\"/author/\")) {\n      // Memotong URL berdasarkan tanda garis miring (/)\n      let pathParts = url.pathname.split('/').filter(Boolean); // Contoh: ['author', 'klint-finley']\n      if (pathParts.length >= 2 && pathParts[0] === 'author') {\n        let slugName = pathParts[1]; // Hasil: 'klint-finley'\n        // Mengubah 'klint-finley' menjadi 'Klint Finley'\n        cleanName = slugName\n          .split('-')\n          .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n          .join(' ');\n      }\n    }\n  } catch (e) {\n    // Jalur alternatif jika URL gagal diproses\n  }\n\n  // 3. Jalur Cadangan (Fallback): Jika bukan halaman author, gunakan metode potong judul kemarin\n  if (!cleanName && rawTitle.includes(\",\")) {\n    cleanName = rawTitle.split(\",\")[0].trim();\n  } else if (!cleanName) {\n    cleanName = \"TechCrunch Contributor\"; // Nama default jika benar-benar tidak ditemukan\n  }\n\n  // Masukkan hasil ke variabel baru\n  item.json.target_name = cleanName;\n  item.json.target_domain = domainName;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -176
      ],
